# Chave publicável do Clerk (dashboard do Clerk -> API Keys)
VITE_CLERK_PUBLISHABLE_KEY=<sua-chave-publicavel-do-clerk>

# Base URL da API do video-service (Python). Em dev, o Vite já faz proxy de
# /api -> http://localhost:8000, então normalmente você não precisa mudar isso.
VITE_API_URL=/api

# Mostra os links "Enviar" e "Seus vídeos" no menu — só faz sentido com o
# video-service (backend real, upload + transcodificação) rodando. Em builds
# via Docker (docker-compose.yml / VPS) já vem "true" por padrão; em deploys
# sem o backend real no ar (ex: a demo no Vercel), deixe sem definir.
VITE_UPLOAD_ENABLED=true

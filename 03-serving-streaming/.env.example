# Copie este arquivo para ".env" e preencha os valores antes de rodar
# `docker compose up`.

# --- Clerk (autenticação — dashboard.clerk.com -> API Keys) ---
VITE_CLERK_PUBLISHABLE_KEY=<sua-chave-publicavel-do-clerk>
CLERK_SECRET_KEY=<sua-chave-secreta-do-clerk>
CLERK_JWKS_URL=https://<seu-dominio>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<seu-dominio>.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=<seu-segredo-de-webhook-do-clerk>

# --- video-service (seu — ajuste como quiser) ---
DATABASE_URL=postgresql://tube:tube@postgres:5432/tube
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
# Endpoint interno (rede do Docker) — usado pelo video-service pra falar com o MinIO.
S3_ENDPOINT_URL=http://minio:9000
# Endpoint público (o que o NAVEGADOR consegue alcançar) — usado ao gerar
# URLs de upload/manifesto HLS que vão pro frontend. Em produção, troque
# pelo domínio público real do seu S3/MinIO.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=tube-videos
# Segredo compartilhado com o MinIO (MINIO_NOTIFY_WEBHOOK_AUTH_TOKEN_PRIMARY)
# pra validar que o webhook em /webhooks/minio realmente veio do MinIO.
MINIO_WEBHOOK_TOKEN=troque-por-um-valor-aleatorio-longo
# Só pro script scripts/seed_youtube.py (importar catálogo do YouTube pra
# não depender só de upload enquanto a base é pequena). Pegue em
# console.cloud.google.com/apis/credentials, restrinja à YouTube Data API v3,
# e NUNCA cole ela direto numa conversa/chat — trate como senha.
YOUTUBE_API_KEY=

# --- postgres ---
POSTGRES_USER=tube
POSTGRES_PASSWORD=tube
POSTGRES_DB=tube

# --- minio ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
